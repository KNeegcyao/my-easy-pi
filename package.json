{
  "name": "my-easy-pi",
  "version": "0.1.2",
  "description": "简易 AI Coding Agent（教学项目）",
  "type": "module",
  "bin": {
    "my-easy-pi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && node scripts/make-cli-executable.mjs",
    "audit": "bash scripts/audit.sh",
    "audit:prod": "npm audit --audit-level=high",
    "outdated": "npm outdated",
    "test": "npx vitest run --reporter=verbose 2>&1; echo \"EXIT_CODE=$?\"",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "cli",
    "assistant",
    "tutorial"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "marked": "^18.0.9"
  }
}
